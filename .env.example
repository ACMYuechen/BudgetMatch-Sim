# 本地 Docker 数据源：先核对现有容器/卷，再填写；不要使用生产连接。
# 旧 postgres:16-alpine 数据卷应保持原镜像；切换 libc / PostgreSQL 大版本须单独迁移。
POSTGRES_IMAGE=pgvector/pgvector:pg16
POSTGRES_PORT=15432
REDIS_PORT=6379
# 宿主机运行服务时使用下面的地址；Compose 内服务会覆盖为 postgres / redis。
DATABASE_DSN="host=127.0.0.1 user=root password=123456 dbname=budgetmatch-sim port=15432 sslmode=disable TimeZone=Asia/Shanghai"
REDIS_ADDRESS=127.0.0.1:6379
REDIS_PASSWORD=12345678

# JWT 签名密钥（自行生成随机字符串，长度建议 ≥ 32）
# 示例：your-random-jwt-secret-key-at-least-32-chars
JWT_SECRET=

# QQ 邮箱 SMTP 配置
# 示例：发件邮箱，如 123456789@qq.com
EMAIL_FROM=
# 示例：邮箱授权码（非登录密码），如 abcdefghijklmno
EMAIL_PASSWORD=

# 阿里云 OSS 配置
# 示例：oss-cn-beijing.aliyuncs.com
OSS_ENDPOINT=
# 示例：LTAI5t9xxxxxxxxxxxxxxxxx
OSS_ACCESS_KEY_ID=
# 示例：2S8ehklIxxxxxxxxxxxxxxxxxxxxxxxx
OSS_ACCESS_KEY_SECRET=
# 示例：your-bucket-name
OSS_BUCKET_NAME=
# 示例：https://your-bucket-name.oss-cn-beijing.aliyuncs.com
OSS_DOMAIN=

# etcd 服务发现与动态配置
# make dev 默认使用 22379，避免本机 12379 端口不可用时导致 RPC 注册失败。
DEV_ETCD_CLIENT_PORT=22379
DEV_ETCD_ENDPOINT=127.0.0.1:22379
ETCD_HOSTS=127.0.0.1:22379

# RocketMQ
# make dev 默认把 NameServer 映射到宿主机 19876，避免 9876 端口冲突。
DEV_ROCKETMQ_NAMESRV_PORT=19876
DEV_ROCKETMQ_NAMESERVERS=127.0.0.1:19876
ROCKETMQ_NAMESERVERS=127.0.0.1:19876
# 宿主服务必须能访问 NameServer 返回的 Broker 地址；make dev 会使用下面的回环地址。
DEV_ROCKETMQ_BROKER_IP1=127.0.0.1
# 手动启动本机依赖时填 127.0.0.1；全容器运行时留空，不能让容器连接自己的回环地址。
ROCKETMQ_BROKER_IP1=

# LLM 模型配置（用于 services/rpc/agent 推荐 Agent）
# Provider 使用 OpenAI 兼容接口名，如 openai
LLM_PROVIDER=openai
# Model 根据服务商填写，如 gpt-4.1-mini / deepseek-flash；不自动转换旧模型名
LLM_MODEL=deepseek-flash
# Flash 当前只验收非思考模式，必须显式设为 disabled；其他模型留空
LLM_THINKING=disabled
# BaseURL 需以 /v1 结尾，或使用完整兼容地址
LLM_BASE_URL=https://api.deepseek.com/v1
# API Key 请替换为你的真实密钥
LLM_API_KEY=

# Embedding 模型配置（用于 agent-rpc 的 RAG 商品语义检索）
# 与 LLM 独立配置：DeepSeek 无 embeddings 接口，需用 OpenAI / 阿里 DashScope 等兼容服务。
# EMBEDDING_PROVIDER 留空则 RAG 关闭，商品检索退回关键词匹配。
EMBEDDING_PROVIDER=
# 示例：text-embedding-3-small（OpenAI）/ BAAI/bge-m3（硅基流动免费版，勿加 Pro/）
EMBEDDING_MODEL=text-embedding-3-small
# 索引维度必须与模型一致：text-embedding-3-small=1536，BAAI/bge-m3=1024。
# 更换模型/维度后须显式迁移索引；不会自动删表。BGE-M3 不发送远端 dimensions 参数。
EMBEDDING_DIMENSIONS=1536
# 示例：https://api.openai.com/v1 或 https://api.siliconflow.cn/v1
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# payment-rpc 调用 mall-rpc 的服务身份密钥，建议至少32字节
PAYMENT_MALL_SERVICE_SECRET=

# Agent → Mall 后台商品索引专用服务密钥，双方配置相同，至少 32 字节随机值。
# 不得复用 JWT_SECRET / PAYMENT_MALL_SERVICE_SECRET；启用 RAG 时必填。
AGENT_MALL_INDEX_SECRET=

# ============================================================
# 支付宝沙箱（payment-rpc）。获取方式见 docs/PAYMENT.md。
# 留空时 payment-rpc 仍可启动，但发起支付会返回未配置错误。
# ============================================================
# 沙箱应用 AppID，示例：2021000xxxxxxxxx
ALIPAY_APP_ID=
# 支付宝商户 PID，一般以2088...开头
ALIPAY_SELLER_ID=
# 应用私钥（PKCS1/PKCS8，单行，去掉 -----BEGIN/END----- 头尾与换行）
ALIPAY_PRIVATE_KEY=
# 支付宝公钥（密钥模式，单行）
ALIPAY_PUBLIC_KEY=
# 异步通知地址（公网可达，沙箱本地可留空，靠 QueryPayment 兜底）
# 示例：https://your-domain.com/api/pay/notify/alipay
ALIPAY_NOTIFY_URL=
# 同步跳转地址（当面付扫码可留空）
ALIPAY_RETURN_URL=
