syntax = "v1"

//////////////////////////////// 鉴权相关 /////////////////////////////////////////////
@server (
	prefix: /api/auth
	group:  auth
	tags:   auth
)
service app {
	@doc "邮箱注册"
	@handler Register
	post /register (RegisterReq) returns (RegisterResp)

	@doc "用户名登录"
	@handler UsernameLogin
	post /login/username (UsernameLoginReq) returns (LoginResp)

	@doc "邮箱登录"
	@handler EmailLogin
	post /login/email (EmailLoginReq) returns (LoginResp)

	@doc "验证码登录"
	@handler LoginByCode
	post /login/code (LoginByCodeReq) returns (LoginResp)

	@doc "发送验证码"
	@handler SendCode
	post /code/send (SendCodeReq) returns (SendCodeResp)
}

//////////////////////////////// 用户相关 ///////////////////////////////////////////
@server (
	prefix: /api/user
	group:  user
	tags:   user
	middleware: AuthMiddleware
)
service app {
	@doc "获取当前用户信息"
	@handler GetUserInfo
	get /info (GetUserInfoReq) returns (GetUserInfoResp)
}

///////////////////////////////////// 基础类型 /////////////////////////////////////////
type UserInfo {
	Id       string `json:"id"`
	Username string `json:"username"`
	Avatar   string `json:"avatar"`
	Phone    string `json:"phone"`
	Email    string `json:"email"`
	Role     int    `json:"role"`
	Status   int    `json:"status"`
	Remark   string `json:"remark"`
}

///////////////////////////////////// 鉴权相关 /////////////////////////////////////////

type RegisterReq {
	Email    string `json:"email" validate:"required,email"`
	Password string `json:"password" validate:"required,min=6"`
	Username string `json:"username" validate:"required,min=2"`
	Code     string `json:"code" validate:"required,len=6"`
}

type RegisterResp {
	Success bool `json:"success"`
}

type UsernameLoginReq {
	Username string `json:"username" validate:"required"`
	Password string `json:"password" validate:"required"`
}

type EmailLoginReq {
	Email    string `json:"email" validate:"required,email"`
	Password string `json:"password" validate:"required"`
}

type LoginResp {
	Token  string `json:"token"`
	UserId string `json:"user_id"`
	Role   int    `json:"role"`
}

type LoginByCodeReq {
	Email string `json:"email" validate:"required,email"`
	Code  string `json:"code" validate:"required,len=6"`
}

type SendCodeReq {
	Email string `json:"email" validate:"required,email"`
}

type SendCodeResp {
	Success bool `json:"success"`
}

////////////////////////////////  用户相关 /////////////////////////////////////////////
type GetUserInfoReq {}

type GetUserInfoResp {
	User UserInfo `json:"user"`
}