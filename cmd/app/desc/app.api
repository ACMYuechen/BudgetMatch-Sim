syntax = "v1"

import (
	"auth/auth.api"
	"seckill/seckill.api"
	"mall/mall.api"
	"payment/payment.api"
	"agent/agent.api"
)

type HealthResp {
	Status string `json:"status"`
	Commit string `json:"commit"`
}

//////////////////////////////// 健康检查 /////////////////////////////////////////////////////
@server (
	prefix: /api
	group:  health
	tags:   health
)
service app {
	@doc "健康检查"
	@handler Health
	get /health returns (HealthResp)
}