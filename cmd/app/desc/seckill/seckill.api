syntax = "v1"

// ========== Activity Types ==========

type ActivityItem {
	Id          string `json:"id"`
	Title       string `json:"title"`
	Description string `json:"description"`
	BannerUrl   string `json:"banner_url"`
	StartTime   string `json:"start_time"`
	EndTime     string `json:"end_time"`
	Status      int32  `json:"status"`
	CreatedAt   string `json:"created_at"`
}

type ActivityListReq {
	Page     int `form:"page,default=1"`
	PageSize int `form:"page_size,default=10"`
	Status   int `form:"status,default=0"`
}

type ActivityListResp {
	List     []ActivityItem `json:"list"`
	Total    int64          `json:"total"`
	Page     int            `json:"page"`
	PageSize int            `json:"page_size"`
}

type ActivityDetailReq {
	Id string `path:"id"`
}

type ActivityDetailResp {
	Activity ActivityItem `json:"activity"`
}

// ========== SKU Types ==========

type SkuItem {
	Id            string `json:"id"`
	ActivityId    string `json:"activity_id"`
	Title         string `json:"title"`
	Subtitle      string `json:"subtitle"`
	Pic           string `json:"pic"`
	OriginalPrice int64  `json:"original_price"`
	SeckillPrice  int64  `json:"seckill_price"`
	Stock         int64  `json:"stock"`
	Sold          int64  `json:"sold"`
	Status        int32  `json:"status"`
	Sort          int64  `json:"sort"`
}

type SkuListReq {
	ActivityId string `form:"activity_id,required"`
	Page       int    `form:"page,default=1"`
	PageSize   int    `form:"page_size,default=10"`
}

type SkuListResp {
	List     []SkuItem `json:"list"`
	Total    int64     `json:"total"`
	Page     int       `json:"page"`
	PageSize int       `json:"page_size"`
}

// ========== Token / Order Types ==========

type AcquireTokenReq {
	ActivityId string `json:"activity_id" validate:"required"`
	SkuId      string `json:"sku_id" validate:"required"`
}

type AcquireTokenResp {
	Token string `json:"token"`
}

type SubmitOrderReq {
	ActivityId string `json:"activity_id" validate:"required"`
	SkuId      string `json:"sku_id" validate:"required"`
	Token      string `json:"token" validate:"required"`
	Quantity   int64  `json:"quantity" validate:"required,min=1"`
}

type SubmitOrderResp {
	OrderId string `json:"order_id"`
	Status  int32  `json:"status"`
}

type GetOrderReq {
	OrderId string `path:"order_id"`
}

type GetOrderResp {
	OrderId     string `json:"order_id"`
	ActivityId  string `json:"activity_id"`
	SkuId       string `json:"sku_id"`
	Quantity    int64  `json:"quantity"`
	TotalAmount int64  `json:"total_amount"`
	Status      int32  `json:"status"`
	CreatedAt   string `json:"created_at"`
}

// ========== Service ==========

@server (
	prefix: /api/seckill
	group:  seckill
	tags:   seckill
	middleware: AuthMiddleware,SeckillRateLimitMiddleware
)
service app {
	@doc "活动列表"
	@handler ActivityList
	get /activities (ActivityListReq) returns (ActivityListResp)

	@doc "活动详情"
	@handler ActivityDetail
	get /activities/:id (ActivityDetailReq) returns (ActivityDetailResp)

	@doc "SKU列表"
	@handler SkuList
	get /skus (SkuListReq) returns (SkuListResp)

	@doc "获取秒杀令牌"
	@handler AcquireToken
	post /token (AcquireTokenReq) returns (AcquireTokenResp)

	@doc "提交秒杀订单"
	@handler SubmitOrder
	post /orders (SubmitOrderReq) returns (SubmitOrderResp)

	@doc "查询订单"
	@handler GetOrder
	get /orders/:order_id (GetOrderReq) returns (GetOrderResp)
}