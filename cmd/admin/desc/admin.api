syntax = "v1"

import (
	"user/user.api"
	"seckill/seckill.api"
	"mall/mall.api"
)

type HealthResp {
	Status string `json:"status"`
	Commit string `json:"commit"`
}

//////////////////////////////// 健康检查 /////////////////////////////////////////////////////
@server (
	prefix: /api
	group:  health
	tags:   health
)
service admin {
	@doc "健康检查"
	@handler Health
	get /health returns (HealthResp)
}