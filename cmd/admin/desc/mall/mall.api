syntax = "v1"

// ========== Product Types ==========

type AdminProductItem {
	Id         string `json:"id"`
	SpuCode    string `json:"spu_code"`
	Name       string `json:"name"`
	CategoryId string `json:"category_id"`
	Brand      string `json:"brand"`
	Status     int32  `json:"status"`
	MainImage  string `json:"main_image"`
	Detail     string `json:"detail"`
	CreatedAt  string `json:"created_at"`
	UpdatedAt  string `json:"updated_at"`
}

type AdminSkuItem {
	Id        string `json:"id"`
	ProductId string `json:"product_id"`
	SkuCode   string `json:"sku_code"`
	Name      string `json:"name"`
	Specs     string `json:"specs"`
	Price     int64  `json:"price"`
	Stock     int64  `json:"stock"`
	Sold      int64  `json:"sold"`
	Status    int32  `json:"status"`
	CreatedAt string `json:"created_at"`
	UpdatedAt string `json:"updated_at"`
}

type AdminCreateProductReq {
	SpuCode    string `json:"spu_code" validate:"required"`
	Name       string `json:"name" validate:"required"`
	CategoryId string `json:"category_id,optional"`
	Brand      string `json:"brand,optional"`
	MainImage  string `json:"main_image,optional"`
	Detail     string `json:"detail,optional"`
}

type AdminCreateProductResp {
	Id string `json:"id"`
}

type AdminUpdateProductReq {
	Id         string `path:"id"`
	Name       string `json:"name,optional"`
	CategoryId string `json:"category_id,optional"`
	Brand      string `json:"brand,optional"`
	Status     int32  `json:"status,optional"`
	MainImage  string `json:"main_image,optional"`
	Detail     string `json:"detail,optional"`
}

type AdminUpdateProductResp {
	Success bool `json:"success"`
}

type AdminProductListReq {
	Page       int    `form:"page,default=1"`
	PageSize   int    `form:"page_size,default=10"`
	CategoryId string `form:"category_id"`
	Keyword    string `form:"keyword"`
	Status     int32  `form:"status,default=-1"`
}

type AdminProductListResp {
	List     []AdminProductItem `json:"list"`
	Total    int64              `json:"total"`
	Page     int                `json:"page"`
	PageSize int                `json:"page_size"`
}

type AdminProductDetailReq {
	Id string `path:"id"`
}

type AdminProductDetailResp {
	Product AdminProductItem `json:"product"`
}

type AdminCreateSkuReq {
	ProductId string `json:"product_id" validate:"required"`
	SkuCode   string `json:"sku_code" validate:"required"`
	Name      string `json:"name" validate:"required"`
	Specs     string `json:"specs"`
	Price     int64  `json:"price" validate:"required,min=1"`
	Stock     int64  `json:"stock" validate:"required,min=0"`
}

type AdminCreateSkuResp {
	Id string `json:"id"`
}

type AdminUpdateSkuReq {
	Id     string `path:"id"`
	Name   string `json:"name,optional"`
	Specs  string `json:"specs,optional"`
	Price  int64  `json:"price,optional"`
	Stock  int64  `json:"stock,optional"`
	Status int32  `json:"status,optional"`
}

type AdminUpdateSkuResp {
	Success bool `json:"success"`
}

type AdminSkuListReq {
	ProductId string `form:"product_id,required"`
	Page      int    `form:"page,default=1"`
	PageSize  int    `form:"page_size,default=10"`
	Status    int32  `form:"status,default=-1"`
}

type AdminSkuListResp {
	List     []AdminSkuItem `json:"list"`
	Total    int64          `json:"total"`
	Page     int            `json:"page"`
	PageSize int            `json:"page_size"`
}

type AdminSkuDetailReq {
	Id string `path:"id"`
}

type AdminSkuDetailResp {
	Sku AdminSkuItem `json:"sku"`
}

// ========== Order Types ==========

type AdminOrderItem {
	ProductId   string `json:"product_id"`
	SkuId       string `json:"sku_id"`
	SkuName     string `json:"sku_name"`
	Price       int64  `json:"price"`
	Quantity    int64  `json:"quantity"`
	TotalAmount int64  `json:"total_amount"`
	Snapshot    string `json:"snapshot"`
}

type AdminOrderResp {
	Id             string           `json:"id"`
	UserId         string           `json:"user_id"`
	TotalAmount    int64            `json:"total_amount"`
	Status         int32            `json:"status"`
	PayType        string           `json:"pay_type"`
	PayTime        string           `json:"pay_time"`
	Remark         string           `json:"remark"`
	Snapshot       string           `json:"snapshot"`
	IdempotencyKey string           `json:"idempotency_key"`
	Items          []AdminOrderItem `json:"items"`
	CreatedAt      string           `json:"created_at"`
	UpdatedAt      string           `json:"updated_at"`
}

type AdminOrderListReq {
	Page     int    `form:"page,default=1"`
	PageSize int    `form:"page_size,default=10"`
	Status   int32  `form:"status,default=-1"`
	UserId   string `form:"user_id"`
}

type AdminOrderListResp {
	List     []AdminOrderResp `json:"list"`
	Total    int64            `json:"total"`
	Page     int              `json:"page"`
	PageSize int              `json:"page_size"`
}

type AdminOrderDetailReq {
	Id string `path:"id"`
}

type AdminOrderDetailResp {
	Order AdminOrderResp `json:"order"`
}

type AdminUpdateOrderStatusReq {
	Id     string `path:"id"`
	Status int32  `json:"status" validate:"required"`
}

type AdminUpdateOrderStatusResp {
	Success bool `json:"success"`
}

type AdminDeleteProductReq {
	Id string `path:"id"`
}

type AdminDeleteSkuReq {
	Id string `path:"id"`
}

// ========== Service ==========

@server (
	prefix: /api/admin/mall
	group:  mall_admin
	tags:   mall_admin
	middleware: AuthMiddleware
)
service admin {
	@doc "创建商品"
	@handler AdminCreateProduct
	post /products (AdminCreateProductReq) returns (AdminCreateProductResp)

	@doc "更新商品"
	@handler AdminUpdateProduct
	put /products/:id (AdminUpdateProductReq) returns (AdminUpdateProductResp)

	@doc "删除商品"
	@handler AdminDeleteProduct
	delete /products/:id

	@doc "商品列表"
	@handler AdminProductList
	get /products (AdminProductListReq) returns (AdminProductListResp)

	@doc "商品详情"
	@handler AdminProductDetail
	get /products/:id (AdminProductDetailReq) returns (AdminProductDetailResp)

	@doc "创建SKU"
	@handler AdminCreateSku
	post /skus (AdminCreateSkuReq) returns (AdminCreateSkuResp)

	@doc "更新SKU"
	@handler AdminUpdateSku
	put /skus/:id (AdminUpdateSkuReq) returns (AdminUpdateSkuResp)

	@doc "删除SKU"
	@handler AdminDeleteSku
	delete /skus/:id

	@doc "SKU列表"
	@handler AdminSkuList
	get /skus (AdminSkuListReq) returns (AdminSkuListResp)

	@doc "SKU详情"
	@handler AdminSkuDetail
	get /skus/:id (AdminSkuDetailReq) returns (AdminSkuDetailResp)

	@doc "订单列表"
	@handler AdminOrderList
	get /orders (AdminOrderListReq) returns (AdminOrderListResp)

	@doc "订单详情"
	@handler AdminOrderDetail
	get /orders/:id (AdminOrderDetailReq) returns (AdminOrderDetailResp)

	@doc "更新订单状态"
	@handler AdminUpdateOrderStatus
	put /orders/:id/status (AdminUpdateOrderStatusReq) returns (AdminUpdateOrderStatusResp)
}
