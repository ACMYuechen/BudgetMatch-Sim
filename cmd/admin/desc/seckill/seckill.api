syntax = "v1"

// ========== Activity Types ==========

type ActivityItem {
	Id          string `json:"id"`
	Title       string `json:"title"`
	Description string `json:"description"`
	BannerUrl   string `json:"banner_url"`
	StartTime   int64  `json:"start_time"`
	EndTime     int64  `json:"end_time"`
	Status      int32  `json:"status"`
	CreatedAt   int64  `json:"created_at"`
	UpdatedAt   int64  `json:"updated_at"`
}

type ActivityListReq {
	Page     int `form:"page,default=1"`
	PageSize int `form:"page_size,default=10"`
	Status   int `form:"status,default=0"`
}

type ActivityListResp {
	List     []ActivityItem `json:"list"`
	Total    int64          `json:"total"`
	Page     int            `json:"page"`
	PageSize int            `json:"page_size"`
}

type ActivityCreateReq {
	Title       string `json:"title" validate:"required,max=128"`
	Description string `json:"description" validate:"max=512"`
	BannerUrl   string `json:"banner_url" validate:"max=512"`
	StartTime   int64  `json:"start_time" validate:"required"`
	EndTime     int64  `json:"end_time" validate:"required"`
}

type ActivityCreateResp {
	Id string `json:"id"`
}

type ActivityDetailReq {
	Id string `path:"id"`
}

type ActivityDetailResp {
	Activity ActivityItem `json:"activity"`
}

type ActivityUpdateReq {
	Id          string `path:"id"`
	Title       string `json:"title" validate:"max=128"`
	Description string `json:"description" validate:"max=512"`
	BannerUrl   string `json:"banner_url" validate:"max=512"`
	StartTime   int64  `json:"start_time"`
	EndTime     int64  `json:"end_time"`
}

type ActivityUpdateResp {
	Success bool `json:"success"`
}

type ActivityDeleteReq {
	Id string `path:"id"`
}

type ActivityDeleteResp {
	Success bool `json:"success"`
}

type ActivityPreheatReq {
	Id string `path:"id"`
}

type ActivityPreheatResp {
	Success bool `json:"success"`
}

type ActivityOnlineReq {
	Id string `path:"id"`
}

type ActivityOnlineResp {
	Success bool `json:"success"`
}

type ActivityOfflineReq {
	Id string `path:"id"`
}

type ActivityOfflineResp {
	Success bool `json:"success"`
}

// ========== SKU Types ==========

type SkuItem {
	Id            string `json:"id"`
	ActivityId    string `json:"activity_id"`
	Title         string `json:"title"`
	Subtitle      string `json:"subtitle"`
	Pic           string `json:"pic"`
	OriginalPrice int64  `json:"original_price"`
	SeckillPrice  int64  `json:"seckill_price"`
	Stock         int64  `json:"stock"`
	Sold          int64  `json:"sold"`
	LockStock     int64  `json:"lock_stock"`
	Status        int32  `json:"status"`
	Sort          int64  `json:"sort"`
	CreatedAt     int64  `json:"created_at"`
	UpdatedAt     int64  `json:"updated_at"`
}

type SkuListReq {
	ActivityId string `form:"activity_id"`
	Page       int    `form:"page,default=1"`
	PageSize   int    `form:"page_size,default=10"`
}

type SkuListResp {
	List     []SkuItem `json:"list"`
	Total    int64     `json:"total"`
	Page     int       `json:"page"`
	PageSize int       `json:"page_size"`
}

type SkuCreateReq {
	ActivityId    string `json:"activity_id" validate:"required"`
	Title         string `json:"title" validate:"max=128"`
	Subtitle      string `json:"subtitle" validate:"max=256"`
	Pic           string `json:"pic" validate:"max=512"`
	OriginalPrice int64  `json:"original_price" validate:"min=0"`
	SeckillPrice  int64  `json:"seckill_price" validate:"required,min=0"`
	Stock         int64  `json:"stock" validate:"min=0"`
	Sort          int64  `json:"sort"`
	MallSkuId     string `json:"mall_sku_id" validate:"max=36"` // 关联商城 SKU，传入则预加载商品信息做快照
}

type SkuCreateResp {
	Id string `json:"id"`
}

type SkuDetailReq {
	Id string `path:"id"`
}

type SkuDetailResp {
	Sku SkuItem `json:"sku"`
}

type SkuUpdateReq {
	Id            string `path:"id"`
	Title         string `json:"title" validate:"max=128"`
	Subtitle      string `json:"subtitle" validate:"max=256"`
	Pic           string `json:"pic" validate:"max=512"`
	OriginalPrice int64  `json:"original_price" validate:"min=0"`
	SeckillPrice  int64  `json:"seckill_price" validate:"min=0"`
	Stock         int64  `json:"stock" validate:"min=0"`
	Sort          int64  `json:"sort"`
	Status        int32  `json:"status" validate:"oneof=0 1 2"`
}

type SkuUpdateResp {
	Success bool `json:"success"`
}

type SkuDeleteReq {
	Id string `path:"id"`
}

type SkuDeleteResp {
	Success bool `json:"success"`
}

// ========== Service ==========

@server (
	prefix: /api/admin/seckill
	group:  seckill
	tags:   seckill
	middleware: AuthMiddleware
)
service admin {
	@doc "活动列表"
	@handler ActivityList
	get /activities (ActivityListReq) returns (ActivityListResp)

	@doc "创建活动"
	@handler ActivityCreate
	post /activities (ActivityCreateReq) returns (ActivityCreateResp)

	@doc "活动详情"
	@handler ActivityDetail
	get /activities/:id (ActivityDetailReq) returns (ActivityDetailResp)

	@doc "更新活动"
	@handler ActivityUpdate
	put /activities/:id (ActivityUpdateReq) returns (ActivityUpdateResp)

	@doc "删除活动"
	@handler ActivityDelete
	delete /activities/:id (ActivityDeleteReq) returns (ActivityDeleteResp)

	@doc "预热活动"
	@handler ActivityPreheat
	post /activities/:id/preheat (ActivityPreheatReq) returns (ActivityPreheatResp)

	@doc "上线活动"
	@handler ActivityOnline
	post /activities/:id/online (ActivityOnlineReq) returns (ActivityOnlineResp)

	@doc "下线活动"
	@handler ActivityOffline
	post /activities/:id/offline (ActivityOfflineReq) returns (ActivityOfflineResp)

	@doc "SKU列表"
	@handler SkuList
	get /skus (SkuListReq) returns (SkuListResp)

	@doc "创建SKU"
	@handler SkuCreate
	post /skus (SkuCreateReq) returns (SkuCreateResp)

	@doc "SKU详情"
	@handler SkuDetail
	get /skus/:id (SkuDetailReq) returns (SkuDetailResp)

	@doc "更新SKU"
	@handler SkuUpdate
	put /skus/:id (SkuUpdateReq) returns (SkuUpdateResp)

	@doc "删除SKU"
	@handler SkuDelete
	delete /skus/:id (SkuDeleteReq) returns (SkuDeleteResp)
}